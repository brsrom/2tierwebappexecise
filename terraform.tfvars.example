location             = "eastus"
resource_group_name  = "rg-2tier-network"
environment          = "dev"

vnet_name           = "vnet-2tier"
vnet_address_space  = ["10.0.0.0/16"]

public_subnet_name           = "snet-public-vm"
public_subnet_address_prefix = ["10.0.1.0/24"]

private_subnet_name           = "snet-private-aks"
private_subnet_address_prefix = ["10.0.2.0/24"]

# Restrict this to your own public IP (e.g. "203.0.113.5/32") instead of "*"
allowed_ssh_source_address_prefix = "*"
